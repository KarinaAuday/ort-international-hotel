@model IEnumerable<ORTInternationalHotel.Web.Models.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<div class="page-header">
    <h1>Habitaciones</h1>
    <a class="btn btn-hero" asp-action="Create">+ Nueva habitaci&oacute;n</a>
</div>

<div class="table-toolbar">
    <input type="search" class="form-control" placeholder="Buscar por numero, tipo u hotel..." data-table-search="tablaHabitaciones" />
</div>

<div class="table-card">
    <table class="table table-striped table-hover align-middle" id="tablaHabitaciones">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Numero)</th>
                <th>@Html.DisplayNameFor(model => model.Tipo)</th>
                <th class="text-center">@Html.DisplayNameFor(model => model.Capacidad)</th>
                <th class="text-end">@Html.DisplayNameFor(model => model.PrecioPorNoche)</th>
                <th>@Html.DisplayNameFor(model => model.Hotel)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
        <tr data-row>
            <td><strong>@Html.DisplayFor(modelItem => item.Numero)</strong></td>
            <td><span class="badge-tipo">@Html.DisplayFor(modelItem => item.Tipo)</span></td>
            <td class="text-center">@Html.DisplayFor(modelItem => item.Capacidad)</td>
            <td class="text-end">@item.PrecioPorNoche.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td>
            <td>@Html.DisplayFor(modelItem => item.Hotel.Ciudad)</td>
            <td class="actions-cell">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalle</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
            <tr class="empty-row is-hidden">
                <td colspan="6">No se encontraron habitaciones con ese criterio.</td>
            </tr>
        </tbody>
    </table>
</div>
