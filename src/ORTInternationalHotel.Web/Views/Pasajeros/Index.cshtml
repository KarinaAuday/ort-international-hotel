@model IEnumerable<ORTInternationalHotel.Web.Models.Pasajero>

@{
    ViewData["Title"] = "Pasajeros";
}

<div class="page-header">
    <h1>Pasajeros</h1>
    <a class="btn btn-hero" asp-action="Create">+ Nuevo pasajero</a>
</div>

<div class="table-toolbar">
    <input type="search" class="form-control" placeholder="Buscar por nombre, documento o email..." data-table-search="tablaPasajeros" />
</div>

<div class="table-card">
    <table class="table table-striped table-hover align-middle" id="tablaPasajeros">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                <th>@Html.DisplayNameFor(model => model.Documento)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                <th>@Html.DisplayNameFor(model => model.PaisOrigen)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
        <tr data-row>
            <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
            <td><strong>@Html.DisplayFor(modelItem => item.Apellido)</strong></td>
            <td>@Html.DisplayFor(modelItem => item.Documento)</td>
            <td>@Html.DisplayFor(modelItem => item.Email)</td>
            <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
            <td>@Html.DisplayFor(modelItem => item.PaisOrigen)</td>
            <td class="actions-cell">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Detalle</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
}
            <tr class="empty-row is-hidden">
                <td colspan="7">No se encontraron pasajeros con ese criterio.</td>
            </tr>
        </tbody>
    </table>
</div>
